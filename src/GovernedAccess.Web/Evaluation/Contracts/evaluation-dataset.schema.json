{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Access deterministic-intake evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetVersion", "environment", "groups"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "datasetVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 100 },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "promoted", "absoluteOutcomeGate", "variations"],
      "properties": {
        "id": { "type": "string", "pattern": "^(EVAL|ADV)-[0-9]{2}$" },
        "promoted": { "type": "boolean" },
        "absoluteOutcomeGate": { "type": "boolean" },
        "variations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variation" }
        }
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "turns", "expectedFinal"],
      "properties": {
        "id": { "type": "string", "pattern": "^(EVAL|ADV)-[0-9]{2}-[A-Z0-9-]+$" },
        "startingState": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/startingState" }
          ]
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/turn" }
        },
        "expectedFinal": { "$ref": "#/$defs/finalExpectation" }
      }
    },
    "startingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate"],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidate" },
        "clarification": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/clarification" }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "environmentId", "roleId", "justification", "incidentId"],
      "properties": {
        "clientId": { "type": ["string", "null"], "maxLength": 200 },
        "environmentId": { "type": ["string", "null"], "maxLength": 200 },
        "roleId": { "type": ["string", "null"], "maxLength": 200 },
        "justification": { "type": ["string", "null"], "maxLength": 2000 },
        "incidentId": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "choices"],
      "properties": {
        "target": { "enum": ["environment", "role"] },
        "choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/choice" }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "displayName", "clientId", "clientDisplayName", "region", "classification"],
      "properties": {
        "canonicalId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "clientId": { "type": ["string", "null"], "maxLength": 200 },
        "clientDisplayName": { "type": ["string", "null"], "maxLength": 200 },
        "region": { "type": ["string", "null"], "maxLength": 200 },
        "classification": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["primary", "recovery"] }
          ]
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requesterMessage", "expected"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "requesterMessage": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "expected": { "$ref": "#/$defs/interpretationExpectation" },
        "failureMode": { "enum": ["none", "providerUnavailable", "mcpUnavailable"] }
      }
    },
    "interpretationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogueAct", "discussionTopic", "failure", "proposal", "allowedTools", "requiredTools", "maximumToolCalls"],
      "properties": {
        "dialogueAct": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["updateDraft", "discussDraft", "requestSubmission", "unrelated", "unclear"] }
          ]
        },
        "discussionTopic": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["currentDraft", "missingInformation", "allowedChanges", "confirmationProcess", "resetInstructions", "unsupported"] }
          ]
        },
        "failure": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["invalidInput", "malformedModelOutput", "executionBudgetExceeded", "timeout", "unavailable"] }
          ]
        },
        "proposal": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/proposal" }
          ]
        },
        "allowedTools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolName" }
        },
        "requiredTools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolName" }
        },
        "maximumToolCalls": { "type": "integer", "minimum": 0, "maximum": 4 },
        "acceptableInterpretations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/interpretationSnapshot" }
        }
      }
    },
    "interpretationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogueAct", "discussionTopic", "failure"],
      "properties": {
        "dialogueAct": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["updateDraft", "discussDraft", "requestSubmission", "unrelated", "unclear"] }
          ]
        },
        "discussionTopic": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["currentDraft", "missingInformation", "allowedChanges", "confirmationProcess", "resetInstructions", "unsupported"] }
          ]
        },
        "failure": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["invalidInput", "malformedModelOutput", "executionBudgetExceeded", "timeout", "unavailable"] }
          ]
        }
      }
    },
    "toolName": {
      "enum": [
        "get_environment_roles",
        "get_incident",
        "get_production_environment",
        "search_production_environments"
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": { "$ref": "#/$defs/operation" },
        "role": { "$ref": "#/$defs/operation" },
        "justification": { "$ref": "#/$defs/operation" },
        "incident": { "$ref": "#/$defs/operation" }
      },
      "minProperties": 1
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "environmentReferenceKind", "value"],
      "properties": {
        "operation": { "enum": ["set", "clear"] },
        "environmentReferenceKind": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["exactEnvironmentId", "searchQuery"] }
          ]
        },
        "value": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "finalExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "lifecycle", "candidate", "clarificationTarget", "clarificationChoiceIds", "scopeResult", "justificationResult"],
      "properties": {
        "outcome": {
          "enum": ["ready", "draftUpdated", "draftUnchanged", "clarification", "discussion", "submissionGuidance", "unrelatedGuidance", "unclearGuidance", "failed"]
        },
        "acceptableOutcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["ready", "draftUpdated", "draftUnchanged", "clarification", "discussion", "submissionGuidance", "unrelatedGuidance", "unclearGuidance", "failed"]
          }
        },
        "lifecycle": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["collecting", "ready", "submitted", "superseded", "expired"] }
          ]
        },
        "candidate": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/candidate" }
          ]
        },
        "clarificationTarget": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["environment", "role"] }
          ]
        },
        "clarificationChoiceIds": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "scopeResult": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/groupResult" }
          ]
        },
        "justificationResult": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/groupResult" }
          ]
        }
      }
    },
    "groupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rejectionReason"],
      "properties": {
        "kind": { "enum": ["applied", "noOp", "rejected", "needsClarification"] },
        "rejectionReason": {
          "oneOf": [
            { "type": "null" },
            { "enum": ["invalid", "unavailable", "conflict", "missingDependency", "environmentQueryTooBroad", "noAssignableRoles", "roleChoiceLimitExceeded"] }
          ]
        }
      }
    }
  }
}
