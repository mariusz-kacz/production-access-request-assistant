{
  "ConnectionStrings": {
    "ReferenceAuthority": "Data Source=governed-access-reference.db",
    "WorkflowPersistence": "Data Source=governed-access-workflow.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff 'UTC' ",
        "UseUtcTimestamp": true
      }
    }
  },
  "TokenValidation": {
    "Enabled": true,
    "Audiences": [],
    "TenantId": ""
  },
  "Connections": {
    "BotServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "Authority": "https://login.microsoftonline.com/botframework.com",
        "ClientId": "",
        "TenantId": "",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "BotServiceConnection"
    }
  ],
  "RequestPreparationModel": {
    "ExecutionProfile": "Deterministic",
    "FoundryResponses": {
      "Endpoint": "",
      "DeploymentName": ""
    }
  },
  "RequestPreparationAgent": {
    "Limits": {
      "MaximumMessageCharacters": 4000,
      "MaximumCallsPerTool": 1,
      "MaximumToolCalls": 4,
      "MaximumProviderIterations": 6,
      "CumulativeTimeout": "00:00:30"
    }
  },
  "TeamsAccessRequest": {
    "AllowedTenantId": "",
    "BotConnectionName": "BotServiceConnection",
    "TrustedWebBaseUri": "",
    "RequestTimeout": "00:01:40",
    "PreparationLifetime": "00:30:00"
  },
  "AllowedHosts": "*"
}
