{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-access.local/contracts/request-intake-proposal.schema.json",
  "title": "Request Intake Proposal",
  "description": "Untrusted structured output from one MAF request-intake turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "candidate",
    "clarificationQuestion"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "clarification",
        "candidate"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "environmentId",
        "requestedRoleId",
        "justification",
        "incidentId"
      ],
      "properties": {
        "clientId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "environmentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "requestedRoleId": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ProductionReadOnly",
            "ProductionSupport",
            null
          ]
        },
        "justification": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "incidentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "clarificationQuestion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    }
  }
}
