{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "size": "Large",
      "weight": "Bolder",
      "text": "Review request draft",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Review the draft below. To change any details, send another message. Confirming submits it for business approval; it does not approve or grant production access.",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        {
          "title": "Client",
          "value": "${clientDisplayName} (${clientId})"
        },
        {
          "title": "Environment",
          "value": "${environmentDisplayName} (${environmentId})"
        },
        {
          "title": "Requested role",
          "value": "${requestedRoleDisplayName} (${requestedRoleId})"
        },
        {
          "title": "Incident",
          "value": "${incidentDisplayNameAndId}"
        },
        {
          "title": "Access lifetime",
          "value": "8 hours after provisioning"
        },
        {
          "title": "Confirm by",
          "value": "${expiresAtUtc}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "weight": "Bolder",
      "text": "Justification",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${justification}",
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Confirm and submit",
      "verb": "confirmAndSubmit",
      "associatedInputs": "none",
      "data": {
        "schemaVersion": 1,
        "preparedRequestId": "${preparedRequestId}"
      }
    }
  ]
}
