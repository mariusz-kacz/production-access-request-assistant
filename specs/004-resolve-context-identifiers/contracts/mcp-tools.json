{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature 004 MCP Tool Contract",
  "endpoint": "/mcp",
  "transport": "streamable-http",
  "maximumEnvironmentCandidates": 20,
  "tools": [
    {
      "name": "get_production_environment",
      "description": "Discovers the bounded production-environment catalog or gets one environment by stable identifier, including authoritative client and assigned role context.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "description": "Optional stable production-environment identifier. Omit for bounded discovery."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environments"
        ],
        "properties": {
          "environments": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environmentId",
                "clientId",
                "clientDisplayName",
                "displayName",
                "roles"
              ],
              "properties": {
                "environmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "clientId": {
                  "type": "string",
                  "minLength": 1
                },
                "clientDisplayName": {
                  "type": "string",
                  "minLength": 1
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "roleId",
                      "displayName"
                    ],
                    "properties": {
                      "roleId": {
                        "type": "string",
                        "enum": [
                          "ProductionReadOnly",
                          "ProductionSupport",
                          "ProductionDeployment"
                        ]
                      },
                      "displayName": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "behavior": {
        "discoveryInput": {},
        "discoverySuccess": "Returns the complete authoritative catalog ordered by environmentId, or an empty array when no environments exist.",
        "exactInput": {
          "environmentId": "PROD-ALPHA-EU"
        },
        "exactSuccess": "Returns exactly one environment in environments[].",
        "exactNotFound": "Returns the shared typed failure envelope with outcome NotFound. The request-preparation consumer keeps scope unresolved and must not call discovery later in the same turn.",
        "invalidInput": "JSON null, blank environmentId, or unknown properties return the shared typed InvalidInput failure.",
        "overflow": "More than 20 authoritative environments returns Unavailable with code environment-candidate-limit-exceeded and no partial list.",
        "ordering": "Environment IDs and role IDs use ordinal ascending ordering."
      }
    },
    {
      "name": "get_incident",
      "description": "Gets one incident using the precise stable identifier supplied by the requester.",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidentId"
        ],
        "properties": {
          "incidentId": {
            "type": "string",
            "minLength": 1,
            "description": "Precise stable incident identifier; titles, descriptions, and partial IDs are not accepted."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidentId",
          "title",
          "status",
          "environmentId"
        ],
        "properties": {
          "incidentId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ]
          },
          "environmentId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "behavior": {
        "exactOnly": true,
        "discovery": false,
        "inference": false
      }
    }
  ],
  "failureEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "outcome",
      "code",
      "message",
      "correlationId"
    ],
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "InvalidInput",
          "NotFound",
          "Timeout",
          "Cancelled",
          "Unavailable"
        ]
      },
      "code": {
        "type": "string",
        "minLength": 1
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "correlationId": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allowlistInvariant": "The initialized server advertises exactly get_production_environment and get_incident, both read-only, and advertises no resources, prompts, role-listing, approval, provisioning, revocation, transition, database, or generic-query tools."
}
