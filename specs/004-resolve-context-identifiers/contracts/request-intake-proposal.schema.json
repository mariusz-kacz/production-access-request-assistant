{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-access.local/contracts/feature-004/request-intake-proposal.schema.json",
  "title": "Feature 004 Request Intake Proposal",
  "description": "Untrusted structured output from one environment-aware MAF request-intake turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "candidate",
    "clarification"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "clarification",
        "candidate"
      ]
    },
    "candidate": {
      "description": "Complete nullable candidate snapshot for this turn. clientId is derived from the selected environment and remains untrusted until deterministic validation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "environmentId",
        "requestedRoleId",
        "justification",
        "incidentId"
      ],
      "properties": {
        "clientId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "environmentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "requestedRoleId": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ProductionReadOnly",
            "ProductionSupport",
            null
          ]
        },
        "justification": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "incidentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "clarification": {
      "description": "One optional focused clarification proposal. Client is derived from environment and therefore is not a clarification target. Environment option IDs are untrusted until reloaded and validated.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "target",
        "message",
        "environmentOptionIds"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "environmentId",
            "requestedRoleId",
            "justification",
            "incidentId"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "environmentOptionIds": {
          "description": "Untrusted proposed shortlist for an environment clarification. Empty for other clarification targets or when no plausible environment exists.",
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
