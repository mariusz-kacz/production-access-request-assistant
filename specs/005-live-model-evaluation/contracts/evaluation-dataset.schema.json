{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-access.local/contracts/evaluation-dataset.schema.json",
  "title": "Governed Access Live-Model Evaluation Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "datasetVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "scenarios": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "successfulResolution",
        "clarificationOrNoMatch",
        "identifierFallback",
        "multiTurn",
        "validationConflict",
        "safetyBoundary"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "environmentId": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "requestedRoleId": {
          "type": ["string", "null"],
          "enum": [
            "ProductionReadOnly",
            "ProductionSupport",
            "ProductionDeployment",
            null
          ]
        },
        "justification": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "incidentId": {
          "type": ["string", "null"],
          "maxLength": 128
        }
      }
    },
    "toolCall": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "expectedOutcome"],
          "properties": {
            "name": {
              "const": "get_production_environment"
            },
            "environmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expectedOutcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "incidentId", "expectedOutcome"],
          "properties": {
            "name": {
              "const": "get_incident"
            },
            "incidentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "expectedOutcome": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "toolExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "orderMatters",
        "allowAdditionalCalls"
      ],
      "properties": {
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          },
          "maxItems": 8
        },
        "orderMatters": {
          "type": "boolean"
        },
        "allowAdditionalCalls": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposalKind",
        "toolCalls",
        "applicationOutcome",
        "forbiddenAuthorityClaim"
      ],
      "properties": {
        "proposalKind": {
          "type": "string",
          "enum": ["candidate", "clarification", "anySchemaValid"]
        },
        "proposalCandidate": {
          "$ref": "#/$defs/candidate"
        },
        "clarificationTarget": {
          "type": ["string", "null"],
          "enum": [
            "environmentId",
            "requestedRoleId",
            "justification",
            "incidentId",
            null
          ]
        },
        "environmentOptionIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "toolCalls": {
          "$ref": "#/$defs/toolExpectation"
        },
        "applicationOutcome": {
          "type": "string",
          "enum": [
            "ready",
            "incomplete",
            "clarification",
            "rejected",
            "providerFailure",
            "cancelled"
          ]
        },
        "sanitizedCandidate": {
          "$ref": "#/$defs/candidate"
        },
        "validationCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "preservedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "clientId",
              "environmentId",
              "requestedRoleId",
              "justification",
              "incidentId"
            ]
          }
        },
        "clearedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "clientId",
              "environmentId",
              "requestedRoleId",
              "justification",
              "incidentId"
            ]
          }
        },
        "forbiddenAuthorityClaim": {
          "type": "boolean"
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requesterMessage", "expected"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "maxLength": 64
        },
        "requesterMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "turns"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(RES|CLR|IDF|MTN|VAL|SAFE)-[0-9]{2}$"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "startingCandidate": {
          "$ref": "#/$defs/candidate"
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/turn"
          }
        }
      }
    }
  }
}
