{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-access.local/contracts/model-execution-profile.schema.json",
  "title": "Request Preparation Model Profile",
  "description": "Server-owned process-wide configuration for selecting exactly the Deterministic or FoundryResponses request-preparation profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ExecutionProfile",
    "FoundryResponses"
  ],
  "properties": {
    "ExecutionProfile": {
      "type": "string",
      "enum": [
        "Deterministic",
        "FoundryResponses"
      ]
    },
    "FoundryResponses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Endpoint",
        "DeploymentName"
      ],
      "properties": {
        "Endpoint": {
          "type": "string",
          "maxLength": 2048
        },
        "DeploymentName": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ExecutionProfile": {
            "const": "FoundryResponses"
          }
        },
        "required": [
          "ExecutionProfile"
        ]
      },
      "then": {
        "properties": {
          "FoundryResponses": {
            "properties": {
              "Endpoint": {
                "minLength": 1,
                "format": "uri",
                "pattern": "^https://[^/?#]+\\.services\\.ai\\.azure\\.com/openai/v1/?$"
              },
              "DeploymentName": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "$comment": "Application validation rejects URI user info, custom ports, extra paths, queries, and fragments, and bounds the configured deployment name. Credentials and tenant selection come from Microsoft Entra identity discovery and are not part of this schema."
}
