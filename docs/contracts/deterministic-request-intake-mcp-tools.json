{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target Governed Access MCP Tool Contract for Deterministic Request Intake",
  "status": "approved-target",
  "contractVersion": "3.0.0",
  "environmentSearchPolicyVersion": "2.0.0",
  "endpoint": "/mcp",
  "transport": "streamable-http",
  "maximumEnvironmentCandidates": 5,
  "maximumCallsPerToolPerTurn": 1,
  "maximumTotalToolCallsPerTurn": 4,
  "maximumProviderIterationsPerTurn": 6,
  "maximumStructuredOutputRepairAttempts": 0,
  "maximumTurnDurationSeconds": 30,
  "sharedPolicies": {
    "environmentSearch": "one protocol-neutral deterministic policy instance is reused by MCP and Core",
    "turnTimeout": "one 30-second timeout/cancellation budget covers model and MCP work",
    "rawArgumentLogging": false,
    "rawResultLogging": false,
    "toolResultTextTrust": "untrusted-data-never-instruction-or-authority"
  },
  "tools": [
    {
      "name": "search_production_environments",
      "description": "Searches the bounded projection of active production environments eligible for access-request intake using one structured agent-proposed query.",
      "authority": "service-catalog-or-cmdb-search-projection",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environments"
        ],
        "properties": {
          "environments": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/environmentProjection"
            }
          }
        }
      },
      "behavior": {
        "queryPolicy": "unicode-nfc-trim-collapse-token-and-match-all-against-approved-fields",
        "sharedImplementation": "same protocol-neutral policy used by MCP and Core",
        "scope": "active production environments eligible for request intake only",
        "ordering": "environmentId ordinal ascending",
        "zeroMatches": "success with environments empty",
        "selectableRange": "two through five complete results may become clarification choices",
        "overflow": "more than five results return Unavailable with code environment_query_too_broad; never expose a larger hidden set, truncate, or rank",
        "applicationAuthority": "Core independently invokes the shared policy and exact-reloads accepted identity",
        "rawQueryLogging": false
      }
    },
    {
      "name": "get_production_environment",
      "description": "Gets one exact active production environment eligible for request intake and its authoritative owning client.",
      "authority": "environment-registry-or-cmdb",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environmentId"
        ],
        "properties": {
          "environmentId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/environmentProjection"
      },
      "behavior": {
        "exactOnly": true,
        "eligibleProductionOnly": true,
        "rolesIncluded": false,
        "notFound": "unknown, inactive, non-production, or intake-ineligible identifiers use shared typed NotFound failure"
      }
    },
    {
      "name": "get_environment_roles",
      "description": "Gets roles currently assignable in one exact eligible production environment; it does not determine requester eligibility.",
      "authority": "iam-or-entitlement-catalog",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environmentId"
        ],
        "properties": {
          "environmentId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "environmentId",
          "roles"
        ],
        "properties": {
          "environmentId": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/roleProjection"
            }
          }
        }
      },
      "behavior": {
        "exactEnvironmentOnly": true,
        "crossEnvironmentSearch": false,
        "requesterEligibilityAuthority": false,
        "knownEnvironmentWithoutAssignments": "success with roles empty",
        "unknownOrIneligibleEnvironment": "shared typed NotFound failure",
        "ordering": "roleId ordinal ascending"
      }
    },
    {
      "name": "get_incident",
      "description": "Gets one incident using an exact stable identifier proposed by the agent; no incident discovery is provided.",
      "authority": "itsm-incident-system",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidentId"
        ],
        "properties": {
          "incidentId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incidentId",
          "title",
          "status",
          "environmentId"
        ],
        "properties": {
          "incidentId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ]
          },
          "environmentId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      },
      "behavior": {
        "exactOnly": true,
        "discovery": false,
        "inference": false,
        "environmentCardinality": "zero or one authoritative environment; null is ineligible for request scope",
        "titleTrust": "untrusted data"
      }
    }
  ],
  "$defs": {
    "environmentProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "displayName",
        "clientId",
        "clientDisplayName"
      ],
      "properties": {
        "environmentId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "clientDisplayName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "roleProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleId",
        "displayName"
      ],
      "properties": {
        "roleId": {
          "type": "string",
          "enum": [
            "ProductionReadOnly",
            "ProductionSupport",
            "ProductionDeployment"
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "failureEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "outcome",
      "code",
      "message",
      "correlationId"
    ],
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "InvalidInput",
          "NotFound",
          "Timeout",
          "Cancelled",
          "Unavailable"
        ]
      },
      "code": {
        "type": "string",
        "minLength": 1
      },
      "message": {
        "type": "string",
        "minLength": 1
      },
      "correlationId": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
